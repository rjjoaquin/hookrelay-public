// SQLite copy of ../schema.prisma for zero-setup local development.
// Keep models identical (minus @db.* types); test/schema-sync.spec.ts checks this.

generator client {
  provider     = "prisma-client"
  output       = "../../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at")
  sessions     Session[]
  sources      Source[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the session token; the raw token only lives in the user's cookie.
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Source {
  id                String        @id @default(uuid())
  userId            String        @map("user_id")
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String       
  slug              String        @unique
  inboundSecret     String?       @map("inbound_secret")
  requiresSignature Boolean       @default(false) @map("requires_signature")
  transform         Json?
  enabled           Boolean       @default(true)
  createdAt         DateTime      @default(now()) @map("created_at")
  destinations      Destination[]
  events            Event[]

  @@index([userId])
  @@map("sources")
}

model Destination {
  id            String     @id @default(uuid())
  sourceId      String     @map("source_id")
  source        Source     @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  url           String    
  signingSecret String     @map("signing_secret")
  enabled       Boolean    @default(true)
  createdAt     DateTime   @default(now()) @map("created_at")
  deliveries    Delivery[]

  @@index([sourceId])
  @@map("destinations")
}

model Event {
  id             String     @id @default(uuid())
  sourceId       String     @map("source_id")
  source         Source     @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  idempotencyKey String?    @map("idempotency_key")
  contentType    String?    @map("content_type")
  headers        Json       @default("{}")
  body           String
  receivedAt     DateTime   @default(now()) @map("received_at")
  deliveries     Delivery[]

  @@unique([sourceId, idempotencyKey])
  @@index([sourceId, receivedAt(sort: Desc)])
  @@index([receivedAt(sort: Desc)])
  @@map("events")
}

enum DeliveryStatus {
  pending
  retrying
  succeeded
  dead
}

model Delivery {
  id             String            @id @default(uuid())
  eventId        String            @map("event_id")
  event          Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  destinationId  String            @map("destination_id")
  destination    Destination       @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  status         DeliveryStatus    @default(pending)
  attempts       Int               @default(0)
  lastStatusCode Int?              @map("last_status_code")
  lastError      String?           @map("last_error")
  nextAttemptAt  DateTime?         @map("next_attempt_at")
  deliveredAt    DateTime?         @map("delivered_at")
  replayOf       String?           @map("replay_of")
  replayedAt     DateTime?         @map("replayed_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  attemptLog     DeliveryAttempt[]

  @@index([eventId])
  @@index([destinationId])
  @@index([status, updatedAt])
  @@map("deliveries")
}

model DeliveryAttempt {
  id            String   @id @default(uuid())
  deliveryId    String   @map("delivery_id")
  delivery      Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  attemptNumber Int      @map("attempt_number")
  statusCode    Int?     @map("status_code")
  durationMs    Int      @map("duration_ms")
  error         String?
  responseBody  String?  @map("response_body")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([deliveryId])
  @@map("delivery_attempts")
}
