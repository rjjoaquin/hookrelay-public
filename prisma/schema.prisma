generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(254)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  sessions     Session[]
  sources      Source[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the session token; the raw token only lives in the user's cookie.
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Source {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @map("user_id") @db.Uuid
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String        @db.VarChar(100)
  slug              String        @unique @db.VarChar(64)
  inboundSecret     String?       @map("inbound_secret") @db.VarChar(128)
  requiresSignature Boolean       @default(false) @map("requires_signature")
  transform         Json?
  enabled           Boolean       @default(true)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz
  destinations      Destination[]
  events            Event[]

  @@index([userId])
  @@map("sources")
}

model Destination {
  id            String     @id @default(uuid()) @db.Uuid
  sourceId      String     @map("source_id") @db.Uuid
  source        Source     @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  url           String     @db.VarChar(2048)
  signingSecret String     @map("signing_secret") @db.VarChar(128)
  enabled       Boolean    @default(true)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz
  deliveries    Delivery[]

  @@index([sourceId])
  @@map("destinations")
}

model Event {
  id             String     @id @default(uuid()) @db.Uuid
  sourceId       String     @map("source_id") @db.Uuid
  source         Source     @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  idempotencyKey String?    @map("idempotency_key") @db.VarChar(255)
  contentType    String?    @map("content_type") @db.VarChar(255)
  headers        Json       @default("{}")
  body           String
  receivedAt     DateTime   @default(now()) @map("received_at") @db.Timestamptz
  deliveries     Delivery[]

  @@unique([sourceId, idempotencyKey])
  @@index([sourceId, receivedAt(sort: Desc)])
  @@index([receivedAt(sort: Desc)])
  @@map("events")
}

enum DeliveryStatus {
  pending
  retrying
  succeeded
  dead
}

model Delivery {
  id             String            @id @default(uuid()) @db.Uuid
  eventId        String            @map("event_id") @db.Uuid
  event          Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  destinationId  String            @map("destination_id") @db.Uuid
  destination    Destination       @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  status         DeliveryStatus    @default(pending)
  attempts       Int               @default(0)
  lastStatusCode Int?              @map("last_status_code")
  lastError      String?           @map("last_error")
  nextAttemptAt  DateTime?         @map("next_attempt_at") @db.Timestamptz
  deliveredAt    DateTime?         @map("delivered_at") @db.Timestamptz
  replayOf       String?           @map("replay_of") @db.Uuid
  replayedAt     DateTime?         @map("replayed_at") @db.Timestamptz
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  attemptLog     DeliveryAttempt[]

  @@index([eventId])
  @@index([destinationId])
  @@index([status, updatedAt])
  @@map("deliveries")
}

model DeliveryAttempt {
  id            String   @id @default(uuid()) @db.Uuid
  deliveryId    String   @map("delivery_id") @db.Uuid
  delivery      Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  attemptNumber Int      @map("attempt_number")
  statusCode    Int?     @map("status_code")
  durationMs    Int      @map("duration_ms")
  error         String?
  responseBody  String?  @map("response_body")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([deliveryId])
  @@map("delivery_attempts")
}
