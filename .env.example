# Everything here is optional for local development.
# With nothing set, HookRelay uses a SQLite file (dev.db) and an in-process queue, no Redis needed.

# Use PostgreSQL instead of SQLite:
# DATABASE_URL=postgres://user:password@localhost:5432/hookrelay

# Use Redis (BullMQ) instead of the in-process queue:
# REDIS_URL=redis://localhost:6379

# Faster retries while testing:
# BACKOFF_BASE_MS=500
# MAX_ATTEMPTS=4

# Production requires NODE_ENV=production, DATABASE_URL (PostgreSQL) and REDIS_URL.
