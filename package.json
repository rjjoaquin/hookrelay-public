{
  "name": "hookrelay",
  "version": "1.0.0",
  "description": "Webhook delivery platform",
  "scripts": {
    "dev": "prisma generate && prisma migrate deploy && nest start --watch",
    "prebuild": "prisma generate",
    "build": "tsc -p tsconfig.build.json",
    "start": "prisma migrate deploy && node dist/main.js",
    "db:migrate": "prisma migrate deploy",
    "seed": "node dist/seed.js",
    "test": "jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rjjoaquin/hookrelay.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/rjjoaquin/hookrelay/issues"
  },
  "homepage": "https://github.com/rjjoaquin/hookrelay#readme",
  "dependencies": {
    "@nestjs/bullmq": "^11.0.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bullmq": "^5.50.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "express": "^5.3.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.0",
    "pg": "^8.16.0",
    "prisma": "^7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.1.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "jest": "^30.0.0",
    "ts-jest": "^29.4.0",
    "typescript": "~5.9.0"
  },
  "private": true,
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test"
    ]
  },
  "engines": {
    "node": ">=20.19"
  },
  "optionalDependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "better-sqlite3": "^13.2.0"
  }
}
